rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all undefined paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Initial Verified Owner Authentication Identity
    function isInitialOwnerAuth() {
      return request.auth != null
        && request.auth.uid == 'VrLNKE3naCXN34GDog4tejrwpO13'
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'kunalkushwaha969@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Initial verified owner retains Admin authority UNLESS explicitly self-revoked in /admins/{uid} during handover
    function isInitialOwner() {
      return isInitialOwnerAuth()
        && (
          !exists(/databases/$(database)/documents/admins/VrLNKE3naCXN34GDog4tejrwpO13)
          || !('role' in get(/databases/$(database)/documents/admins/VrLNKE3naCXN34GDog4tejrwpO13).data)
          || get(/databases/$(database)/documents/admins/VrLNKE3naCXN34GDog4tejrwpO13).data.role != 'revoked'
        );
    }

    // Full Admin role: Initial owner (while active) OR verified replacement admin with role == 'admin' in /admins/{uid}
    function isFullAdmin() {
      return isInitialOwner() || (
        request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Merchant role: verified active store operator with role == 'merchant' in /admins/{uid}
    function isMerchant() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'merchant';
    }

    // Store staff: either full admin or merchant
    function isStoreStaff() {
      return isFullAdmin() || isMerchant();
    }

    // Ensures approved_by matches the authenticated actor's verified email or UID, preventing forgery or fake approver preservation
    function isAuthenticApprover(data) {
      return 'approved_by' in data
        && data.approved_by is string
        && data.approved_by.size() > 0
        && data.approved_by.size() <= 200
        && (
          (
            'email' in request.auth.token
            && request.auth.token.email is string
            && request.auth.token.email_verified == true
            && data.approved_by.lower() == request.auth.token.email.lower()
          )
          || data.approved_by == request.auth.uid
        );
    }

    // Context-safe helpers: Separated for existing documents (safe for delete/update) vs incoming data (safe for create/update)
    function isExistingInitialOwnerDoc(adminUid) {
      return adminUid == 'VrLNKE3naCXN34GDog4tejrwpO13'
        || (resource != null && 'email' in resource.data && resource.data.email is string && resource.data.email.lower() == 'kunalkushwaha969@gmail.com');
    }

    function isIncomingInitialOwnerDoc(data, adminUid) {
      return adminUid == 'VrLNKE3naCXN34GDog4tejrwpO13'
        || ('email' in data && data.email is string && data.email.lower() == 'kunalkushwaha969@gmail.com');
    }

    function hasVerifiedReplacementAdmin(data) {
      return 'handover_to_uid' in data
        && data.handover_to_uid is string
        && data.handover_to_uid.size() > 0
        && data.handover_to_uid.size() <= 128
        && data.handover_to_uid != 'VrLNKE3naCXN34GDog4tejrwpO13'
        && exists(/databases/$(database)/documents/admins/$(data.handover_to_uid))
        && get(/databases/$(database)/documents/admins/$(data.handover_to_uid)).data.role == 'admin';
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'role', 'approved_by'])
        && data.keys().hasOnly(['uid', 'role', 'email', 'displayName', 'approved_by', 'handover_to_uid', 'created_at', 'updated_at'])
        && data.uid is string && data.uid == adminUid
        && data.role in ['admin', 'merchant', 'revoked']
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('handover_to_uid' in data) || (data.handover_to_uid is string && data.handover_to_uid.size() <= 128))
        && (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 64))
        && (!('updated_at' in data) || (data.updated_at is string && data.updated_at.size() <= 64))
        && isAuthenticApprover(data);
    }

    function isValidUserRegistration(data, userUid) {
      return data.keys().hasAll(['uid', 'email', 'provider'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'provider', 'created_at', 'updated_at'])
        && data.uid is string && data.uid == userUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && 'email' in request.auth.token && request.auth.token.email is string
        && data.email.lower() == request.auth.token.email.lower()
        && data.provider in ['password', 'google', 'email']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 64))
        && (!('updated_at' in data) || (data.updated_at is string && data.updated_at.size() <= 64))
        && (data.email.lower() != 'kunalkushwaha969@gmail.com' || userUid == 'VrLNKE3naCXN34GDog4tejrwpO13')
        && (userUid != 'VrLNKE3naCXN34GDog4tejrwpO13' || request.auth.token.email_verified == true);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0;
    }

    function isValidNewOrder(data) {
      return data.customer_details is map
        && data.customer_details.name is string && data.customer_details.name.size() >= 2
        && data.customer_details.phone is string && data.customer_details.phone.size() >= 10
        && data.customer_details.address is string && data.customer_details.address.size() >= 5
        && data.items is list && data.items.size() > 0
        && data.total is number && data.total >= 0
        && data.status in ['Pending', 'Order Received', 'Pending UPI Payment'];
    }

    function isValidOrderStatus(data) {
      return data.status in [
        'Pending',
        'Order Received',
        'Pending UPI Payment',
        'Confirmed',
        'Packed',
        'Shipped',
        'Delivered',
        'Cancelled'
      ];
    }

    // Admins lookup collection:
    // Only the verified initial owner UID can create, promote, demote, revoke, or delete operator/admin records.
    // Existing non-owner admins cannot grant admin privileges to other users.
    // The initial owner's admin record cannot be modified or deleted by another account.
    match /admins/{adminUid} {
      allow get: if request.auth != null && (request.auth.uid == adminUid || isInitialOwner());
      allow list: if isInitialOwner();

      // Create: Owner can approve a new operator (cannot create a duplicate initial owner doc)
      allow create: if isInitialOwner()
        && isValidAdminRecord(request.resource.data, adminUid)
        && !isIncomingInitialOwnerDoc(request.resource.data, adminUid)
        && request.auth.uid != adminUid;

      // Update: Owner can promote, demote, or revoke an operator, or execute verified replacement handover
      allow update: if isInitialOwner()
        && isValidAdminRecord(request.resource.data, adminUid)
        && (
          (
            !isIncomingInitialOwnerDoc(request.resource.data, adminUid)
            && !isExistingInitialOwnerDoc(adminUid)
            && request.auth.uid != adminUid
          )
          || (
            isInitialOwnerAuth()
            && adminUid == 'VrLNKE3naCXN34GDog4tejrwpO13'
            && request.resource.data.role == 'revoked'
            && 'email' in request.resource.data && request.resource.data.email is string && request.resource.data.email.lower() == 'kunalkushwaha969@gmail.com'
            && 'approved_by' in request.resource.data && request.resource.data.approved_by is string && (
              request.resource.data.approved_by.lower() == 'kunalkushwaha969@gmail.com'
              || request.resource.data.approved_by == 'VrLNKE3naCXN34GDog4tejrwpO13'
            )
            && hasVerifiedReplacementAdmin(request.resource.data)
          )
        );

      // Delete: Owner can remove an operator record (cannot delete initial owner doc or self)
      allow delete: if isInitialOwner()
        && request.auth.uid != adminUid
        && !isExistingInitialOwnerDoc(adminUid);
    }

    // Registered users directory:
    // Users create/update only their own profile with their verified token email.
    // The initial owner's email is protected: no other UID can claim kunalkushwaha969@gmail.com.
    // Only full store administrators can list registered accounts for approval.
    match /users/{userUid} {
      allow get: if request.auth != null && (request.auth.uid == userUid || isFullAdmin());
      allow list: if isFullAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == userUid
        && isValidUserRegistration(request.resource.data, userUid);
      allow delete: if false;
    }

    // Products collection:
    // Publicly browsable by customers;
    // Full admins and store operators (merchants) can create and update catalog items;
    // Only full admins can delete products (merchants cannot delete products).
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isStoreStaff() && isValidProduct(request.resource.data);
      allow delete: if isFullAdmin();
    }

    // Orders collection:
    // Public customers submit new orders;
    // Store staff (admins and merchants) view orders and update fulfillment status;
    // Only full admins can delete orders.
    match /orders/{orderId} {
      allow read: if isStoreStaff();
      allow create: if isValidNewOrder(request.resource.data);
      allow update: if isStoreStaff() && isValidOrderStatus(request.resource.data);
      allow delete: if isFullAdmin();
    }

    // Store Settings collection:
    // Publicly readable for storefront rendering;
    // Only full admins can update store settings (merchants cannot change store settings or payment details).
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isFullAdmin()
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if false;
    }
  }
}
