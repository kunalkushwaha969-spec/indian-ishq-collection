rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isInitialOwnerAuth() {
      return request.auth != null
        && request.auth.uid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13']
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'kunalkushwaha969@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Initial verified owner retains Admin access UNLESS explicitly self-revoked in /admins/{uid} during handover
    function isInitialOwner() {
      return isInitialOwnerAuth()
        && (
          !exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          !(
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'revoked'
            && (
              get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.approved_by in [
                'kunalkushwaha969@gmail.com',
                'VrLNKE3naCXN34GDog4tejrwpO13',
                'VrLNKE3naCXN34GDog4tejrwPO13'
              ]
            )
          )
        );
    }

    // Full Admin role: Initial owner (while not revoked) OR any user with role == 'admin' in /admins/{uid}
    function isFullAdmin() {
      return isInitialOwner() || (
        request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Store Operator role: either 'admin' or 'merchant' in /admins/{uid}
    function hasAuthorizedMerchantRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'merchant'];
    }

    function isAdmin() {
      return isInitialOwner() || hasAuthorizedMerchantRole();
    }

    function isAuthenticApprover(data) {
      return !('approved_by' in data)
        || data.approved_by == request.auth.token.email
        || data.approved_by == request.auth.uid
        || (resource != null && 'approved_by' in resource.data && data.approved_by == resource.data.approved_by);
    }

    function isTargetInitialOwnerRecord(adminUid) {
      return adminUid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13']
        || (resource != null && 'email' in resource.data && resource.data.email is string && resource.data.email.lower() == 'kunalkushwaha969@gmail.com')
        || (request.resource != null && 'email' in request.resource.data && request.resource.data.email is string && request.resource.data.email.lower() == 'kunalkushwaha969@gmail.com');
    }

    function hasVerifiedReplacementAdmin(data) {
      return 'handover_to_uid' in data
        && data.handover_to_uid is string
        && data.handover_to_uid.size() > 0
        && data.handover_to_uid.size() <= 128
        && !(data.handover_to_uid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13'])
        && exists(/databases/$(database)/documents/admins/$(data.handover_to_uid))
        && get(/databases/$(database)/documents/admins/$(data.handover_to_uid)).data.role == 'admin';
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['role'])
        && data.keys().hasOnly(['uid', 'role', 'email', 'displayName', 'approved_by', 'handover_to_uid', 'created_at', 'updated_at'])
        && data.role in ['admin', 'merchant', 'revoked']
        && (!('uid' in data) || (data.uid is string && data.uid == adminUid))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('approved_by' in data) || (data.approved_by is string && data.approved_by.size() <= 200))
        && (!('handover_to_uid' in data) || (data.handover_to_uid is string && data.handover_to_uid.size() <= 128))
        && (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 64))
        && (!('updated_at' in data) || (data.updated_at is string && data.updated_at.size() <= 64))
        && isAuthenticApprover(data);
    }

    function isValidUserRegistration(data, userUid) {
      return data.keys().hasAll(['uid', 'email', 'provider'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'provider', 'created_at', 'updated_at'])
        && data.uid is string && data.uid == userUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && 'email' in request.auth.token && request.auth.token.email is string
        && data.email.lower() == request.auth.token.email.lower()
        && data.provider in ['password', 'google', 'email']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 64))
        && (!('updated_at' in data) || (data.updated_at is string && data.updated_at.size() <= 64))
        && (data.email.lower() != 'kunalkushwaha969@gmail.com' || userUid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13'])
        && (!(userUid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13']) || request.auth.token.email_verified == true);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0;
    }

    function isValidNewOrder(data) {
      return data.customer_details is map
        && data.customer_details.name is string && data.customer_details.name.size() >= 2
        && data.customer_details.phone is string && data.customer_details.phone.size() >= 10
        && data.customer_details.address is string && data.customer_details.address.size() >= 5
        && data.items is list && data.items.size() > 0
        && data.total is number && data.total >= 0
        && data.status in ['Pending', 'Order Received', 'Pending UPI Payment'];
    }

    function isValidOrderStatus(data) {
      return data.status in [
        'Pending',
        'Order Received',
        'Pending UPI Payment',
        'Confirmed',
        'Packed',
        'Shipped',
        'Delivered',
        'Cancelled'
      ];
    }

    // Admins lookup collection:
    // Each document ID must equal the Firebase Authentication UID and contain role: "admin", "merchant", or "revoked".
    // Only full Admins can list or modify /admins.
    // The Initial Owner (UID: VrLNKE3naCXN34GDog4tejrwpO13 / VrLNKE3naCXN34GDog4tejrwPO13) is protected directly by UID:
    // Non-owner administrators can NEVER create, overwrite, demote, revoke, or delete the initial owner's admin record.
    // Non-initial-owner Admins cannot demote or delete their own UID. Initial-owner self-revocation requires a verified replacement Admin.
    match /admins/{adminUid} {
      allow get: if request.auth != null && (request.auth.uid == adminUid || isFullAdmin());
      allow list: if isFullAdmin();
      allow create, update: if isFullAdmin()
        && isValidAdminRecord(request.resource.data, adminUid)
        && (
          !isTargetInitialOwnerRecord(adminUid)
          || (isInitialOwnerAuth() && request.auth.uid == adminUid)
        )
        && (
          request.auth.uid != adminUid
          || request.resource.data.role == 'admin'
          || (
            isInitialOwnerAuth()
            && request.auth.uid == adminUid
            && request.resource.data.role == 'revoked'
            && 'email' in request.resource.data && request.resource.data.email is string && request.resource.data.email.lower() == 'kunalkushwaha969@gmail.com'
            && 'approved_by' in request.resource.data && request.resource.data.approved_by is string && (
              request.resource.data.approved_by.lower() == 'kunalkushwaha969@gmail.com'
              || request.resource.data.approved_by in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13']
            )
            && hasVerifiedReplacementAdmin(request.resource.data)
          )
        );
      allow delete: if isFullAdmin()
        && request.auth.uid != adminUid
        && !isTargetInitialOwnerRecord(adminUid)
        && !(adminUid in ['VrLNKE3naCXN34GDog4tejrwpO13', 'VrLNKE3naCXN34GDog4tejrwPO13']);
    }

    // Registered users directory:
    // Authenticated users can only create/update their own profile with their verified Auth token email (no cross-account edits or impersonation).
    // The initial owner's email is protected: no other UID can register with kunalkushwaha969@gmail.com.
    match /users/{userUid} {
      allow get: if request.auth != null && (request.auth.uid == userUid || isFullAdmin());
      allow list: if isFullAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == userUid
        && isValidUserRegistration(request.resource.data, userUid);
      allow delete: if false;
    }

    // Products collection:
    // Publicly browsable by customers; only authenticated store administrators can create, update, or delete
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Orders collection:
    // Customers can submit new orders (initial status Pending / Order Received);
    // Only authenticated store administrators can read orders or update order status
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidNewOrder(request.resource.data);
      allow update: if isAdmin() && isValidOrderStatus(request.resource.data);
      allow delete: if isAdmin();
    }

    // Store Settings collection:
    // Publicly readable for storefront rendering; only authenticated store administrators can update
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0;
      allow delete: if false;
    }
  }
}

