rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.customer_details != null
        && data.items is list
        && data.total is number && data.total >= 0;
    }

    // Products collection:
    // Live catalog and inventory: browsable by all visitors and editable by store managers
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidProduct(request.resource.data);
      allow delete: if true;
    }

    // Orders collection:
    // Placed by customers upon checkout and reviewed by merchant in workspace
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder(request.resource.data);
      allow update, delete: if true;
    }
  }
}
